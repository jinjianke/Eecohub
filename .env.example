# Retiehe Host API key. Keep the real value only in .env.local or the server environment.
RTH_API_KEY=

# Retiehe site used by the legacy/default deployment path.
RTH_SITE=your-site-name
RTH_PUBLIC_URL=https://your-site-name.rth1.xyz

# Optional legacy migration card. Leave empty for a fresh installation.
EECOHUB_CARD_CODE=

# Set a strong password in .env.local or the production environment.
EECOHUB_ADMIN_PASSWORD=
